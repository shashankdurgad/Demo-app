# Required: LLM provider (pick one)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Or local Ollama instead of OpenAI
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Required for Gmail read-only OAuth (local)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Encrypts the local session cookie (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Overmind telemetry (optional — tracing is a no-op when unset)
OVERMIND_API_KEY=
# OVERMIND_API_URL=https://api.overmindlab.ai
# OVERMIND_AGENT_ID=
# OVERMIND_AGENT_NAME=invoice-agent
# OVERMIND_PROJECT_ID=
# OVERMIND_ENVIRONMENT=development
# OVERMIND_SERVICE_NAME=invoice-agent
# Experimental: nest all analyzeEmail entry_points under one batch root
# (repro multi-invocation scoring). Default off = one root per email.
# OVERMIND_NEST_ENTRY_POINTS=1
